# Puertos locales
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL local
POSTGRES_DB=argos_clinical
POSTGRES_USER=argos_app
POSTGRES_PASSWORD=argos_app_local

# Backend Spring Boot
APP_VERSION=0.1.0
DB_MIGRATIONS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:5173
ARGOS_TEMAS_PROVIDER=LOCAL
ARGOS_TEMAS_MIN_CONFIDENCE=0.60
ANTHROPIC_TOPICS_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TOPICS_MAX_TOKENS=900

# Email SMTP local para verificacion de cuentas
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=argosclinical@gmail.com
MAIL_PASSWORD=COMPLETAR_APP_PASSWORD_DE_GMAIL
MAIL_FROM=argosclinical@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
EMAIL_VERIFICATION_EXPIRATION_HOURS=24

# Login/JWT local
# ARGOS-152: access token corto (15 min); la sesión persiste vía refresh token rotativo
# (30 días, cookie HttpOnly clinico_session, ver POST /api/auth/refresh) en vez de un access
# token de larga duración.
JWT_SECRET=argos-clinical-local-dev-secret-32-bytes-minimum
JWT_ACCESS_MINUTES=15
JWT_ISSUER=argos-clinical
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Back Office: credenciales del primer administrador (ADMIN_PLATAFORMA). Sin estas dos
# variables, el seed NO crea ningún administrador (nunca hay credenciales por defecto
# conocidas). Se aplican una sola vez, cuando la tabla administradores está vacía.
ADMIN_SEED_EMAIL=admin@argosclinical.com
ADMIN_SEED_PASSWORD=COMPLETAR_PASSWORD_SEGURA

# Servicio de transcripcion (faster-whisper)
TRANSCRIPCION_PORT=9000
TRANSCRIPCION_SERVICE_URL=http://transcripcion:9000
TRANSCRIPCION_REALTIME_TIMEOUT_SECONDS=20
TRANSCRIPCION_REALTIME_RETRIES=3
TRANSCRIPCION_REALTIME_BACKOFF_MS=1000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_IDIOMA=es
WHISPER_BEAM_SIZE=3
WHISPER_REFINEMENT_BEAM_SIZE=5
WHISPER_HOTWORDS=
WHISPER_MAX_REFINEMENT_AUDIO_BYTES=134217728
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=2
WHISPER_MAX_CONCURRENT_INFERENCES=2
WHISPER_VAD_MIN_SILENCE_MS=250

# Servicio de analisis emocional visual
EMOCIONES_PORT=9010
EMOCIONES_SERVICE_URL=http://emociones:9010
EMOCIONES_MODEL_ID=emotiefflib-enet-b0-8-va-mtl

# --- Calibracion de la confianza visual ------------------------------------------------
# Sobre habla conversacional el modelo informaba 47,65 % de confianza promedio y acertaba el
# 28,71 %: el numero que veia el profesional exageraba en 19 puntos. Con T=2,40 informa
# 30,32 %, y el ECE baja de 0,1895 a 0,0770.
#
# NO cambia ninguna prediccion: dividir los logits por T preserva el argmax. Solo cambia la
# seguridad declarada. Poner 1.0 revierte al comportamiento anterior sin redeploy.
#
# ⚠ LAS DOS VARIABLES SE MUEVEN JUNTAS. Al calibrar, las confianzas bajan; dejar el umbral en
# 0,45 silenciaria casi todo. 0,291 es el equivalente que conserva el punto de operacion
# (mediana sobre MELD, CREMA-D y RAVDESS). Cambiar una sola lo mueve sin que nadie lo decida.
EMOCIONES_VIDEO_TEMPERATURE=2.40
EMOCIONES_VIDEO_MIN_CONFIDENCE=0.291

# --- Fusion emocional intermedia (ARGOS-169, ADR-024) ---------------------------------
# ENCENDIDA desde 2026-08-03 (ADR-024). Combina las representaciones de audio y video
# en vez de sus decisiones. La v2 mide accuracy 0,7936 contra 0,6420 del modelo visual
# desplegado, con p<0,0001 y +160 clips netos, y degrada con gracia si falta una
# modalidad: incluso sin video queda en 0,6477.
#
# ADVERTENCIA CLINICA: su recall en tristeza (0,52) sigue POR DEBAJO del modelo visual
# solo (0,72). Gana en enojo y miedo y paga con la tristeza, que es la clase mas
# relevante en salud mental. Documentado en fusion-v2-con-meld-2026-08-03.md.
#
# Para revertir: poner false y `docker compose up -d emociones`. Segundos, sin redeploy
# ni cambio de imagen. Ver governance/ARGOS_Runbook_Respaldo_y_Reversion_Emociones.md.
EMOCIONES_FUSION_INTERMEDIA_ENABLED=true
# EMOCIONES_FUSION_ARTEFACTO se define UNA sola vez, en el bloque ARGOS-169 de mas abajo.
#
# Estaba declarada dos veces -aca en v2 y alla en v3- y ganaba la ultima. Peligroso: borrar
# el bloque de abajo habria vuelto a la v2 en silencio, y como la v2 NO declara con que
# encoder fue entrenada, la guarda la acepta "por compatibilidad" en vez de rechazarla. Es
# decir: embeddings del encoder adaptado entrando a un clasificador entrenado sobre el otro,
# sin error, sin log, con una emocion plausible en la salida.
# Umbral de abstencion por confianza, derivado de la curva abstencion-precision sobre los
# embeddings cacheados de RAVDESS (ARGOS-110). Regla declarada antes de mirar los resultados:
# maximo UAR sin degradar el recall de tristeza. A 0 la abstencion queda apagada.
#
# Que coincida con el 0,450 del fusionador anterior es casualidad: aquel numero se eligio sin
# datos y opera sobre otra escala -25 % de abstencion contra 3,5 %-.
#
# Este archivo se copia a .env, y .env le gana al default del compose: dejarlo en 0.0 apagaba
# en silencio el umbral que la medicion adopto.
EMOCIONES_FUSION_UMBRAL=0.45

# Correccion por prior (logit adjustment, angel/correccion_por_prior_fusion.py): el clasificador
# aprendio la distribucion de sus corpus de entrenamiento (balanceados a proposito), muy distinta
# de una sesion real donde "neutral" domina. 1.20 medido sobre RAVDESS con split fit/reporte
# disjunto en hablante: UAR 0,7795 -> 0,7917, recall 'neutral' 0,6250 -> 0,8125, 'sad' sin
# retroceder (0,6250 -> 0,6354), sesgo de confianza +0,0432 -> +0,0333.
#
# REVERSION: poner en 0 y reiniciar el servicio de emociones. Segundos, sin redesplegar imagenes.
EMOCIONES_FUSION_TAU=1.20

# Expone el embedding del encoder de Whisper en /embed, que la fusion necesita.
WHISPER_EMBEDDING_ENABLED=true

# ─── ARGOS-169 / ADR-025 · Encoder de audio adaptado y fusion v3 ────────────────────────
#
# Hasta 2026-08-06 el embedding salia del MISMO encoder que transcribe, sin adaptar. Ese
# encoder reconoce el volumen mas que la emocion: por la ruta de produccion detecta 9
# tristezas de cada 100. El adaptado detecta 61.
#
# Los TRES cambios de abajo van JUNTOS. La fusion v3 declara con que encoder fue entrenada y
# RECHAZA con 400 los embeddings de otro, asi que encender uno solo falla ruidosamente en vez
# de producir emociones plausibles sobre un espacio latente equivocado.
#
# ORDEN DE DESPLIEGUE: transcripcion primero -expone /embed con el encoder nuevo y como nadie
# lo consume todavia no cambia nada-, despues emociones con la v3, y por ultimo el backend.
#
# REVERSION: ARGOS_FUSION_INTERMEDIA_ENABLED=false y reiniciar el backend. Segundos, sin
# redesplegar imagenes.
#
# El encoder adaptado NO reemplaza al de transcripcion: degrada el WER en +0,2535 -12,7 veces
# el umbral- porque empuja al decoder a bucles de repeticion. Conviven; cuesta 179 MB de RSS.
#
# ACTIVAS EN PRODUCCION desde 2026-08-06 (ADR-025 Aceptado). Los defaults de
# docker-compose.prod.yml ya las traen encendidas; estas lineas son para el entorno local.
#
# 1) transcripcion: segunda instancia de Whisper, solo para /embed
WHISPER_EMBEDDING_MODEL=/modelos/whisper-argos-ser-int8
WHISPER_ENCODER_ID=whisper-small-argos-ser-int8
#
# 2) emociones: la fusion entrenada sobre ese encoder
EMOCIONES_FUSION_ARTEFACTO=/app/angel/artefactos/fusion-intermedia-v3.npz
#
# 3) backend: la ruta /embed + /infer/fusion. Sin esto, los otros dos no se usan.
ARGOS_FUSION_INTERMEDIA_ENABLED=true
# EMOCIONES_AUDIO_MODEL_ID / EMOCIONES_AUDIO_ENABLED se eliminaron junto con la fusion
# tardia: gobernaban el clasificador acustico argos-audio-cnn-ravdess, descartado por
# evaluacion. El audio participa como representacion en la fusion intermedia (ADR-025).
EMOCIONES_MOCK=false
EMOCIONES_STRICT_LOAD=true
EMOCIONES_REQUIRE_FACE_TRACKING=true
EMOCIONES_TIMEOUT_MS=5000

# Nota clinica asistida (Epica 5 - Claude / Anthropic)
# ⚠️  REQUERIDA para que la nota clinica funcione. Conseguila en https://console.anthropic.com/
# En prod va en SSM Parameter Store bajo /argos/prod/ANTHROPIC_API_KEY — nunca en el repo.
ANTHROPIC_API_KEY=sk-ant-COMPLETAR
ANTHROPIC_MODEL=claude-sonnet-5

# Cifrado en reposo de transcripciones y notas (ADR-007). En dev el backend usa un
# default si queda vacio; en prod DEBE definirse (va en SSM, nunca en el repo).
ENCRYPTION_KEY=

# Retención temporal de grabaciones (deshabilitada por defecto en local)
RECORDINGS_ENABLED=false
RECORDINGS_BUCKET=
RECORDINGS_KMS_KEY_ID=alias/aws/s3
RECORDINGS_MAX_RETENTION_HOURS=720
RECORDINGS_MAX_BYTES=2147483648
PROCESSING_AUDIO_ENABLED=false
PROCESSING_AUDIO_MAX_RETENTION_HOURS=2
PROCESSING_AUDIO_MAX_BYTES=134217728
TRANSCRIPCION_REFINEMENT_TIMEOUT_MINUTES=120

# ARGOS-110 (ADR-026). Agrupamiento de voces en sesiones presenciales, donde un solo microfono
# mezcla a las dos personas. Apagada: falta medir DER sobre habla presencial real, que es lo unico
# que ninguna cantidad de ingenieria reemplaza.
#
# Encendida, el pipeline post-sesion frena antes de la nota clinica hasta que el profesional dice
# que grupo de voces es el paciente. Los pasos que no dependen del hablante -transcripcion, temas,
# emociones- corren igual, sin esperar.
ARGOS_DIARIZACION_ENABLED=false
# Cuanto espera esa compuerta antes de continuar sola con los hablantes sin verificar. Es la unica
# garantia de terminacion: una nota con atribucion incompleta es mejor que una sesion que nunca
# produce nota.
ARGOS_ESPERA_ASIGNACION_HORAS=24

AWS_REGION=us-east-1

# Frontend Vite
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_ENV=development
CHOKIDAR_USEPOLLING=true
