# Copiar a terraform.tfvars solamente si se necesita cambiar defaults.
# La cuenta nueva (616322963974) usa el perfil argos-nuevos; la vieja usaba argos-facu.
profile       = "argos-nuevos"
region        = "us-east-1"
instance_type = "c7i.2xlarge"

# Modo demo IA con GPU. Requiere cuota EC2 G/VT aprobada antes de aplicar.
demo_gpu         = false
gpu_instance_type = "g6.2xlarge"

domain_name = "argosclinical.online"

# WebACL propio asociado a CloudFront. Apagado por defecto: cuesta del orden de USD 9/mes.
# Ver ADR-023 y MIGRACION-CUENTA-AWS.md antes de encenderlo.
waf_habilitado = false

monthly_budget_usd = 25
budget_email       = "95001@sistemas.frc.utn.edu.ar"

# Host provisorio hasta el cambio de NS; vaciar después (ver MIGRACION-CUENTA-AWS.md).
origenes_cors_adicionales = []
