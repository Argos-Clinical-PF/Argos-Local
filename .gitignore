.env.backup*
.env.bak
.env.*.local
.DS_Store
terraform/.terraform/
terraform/.build/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfplan
terraform/*.pem
terraform/*.key
terraform/argos-deploy.pub

# Ajustes locales de cada desarrollador: nunca se versionan.
docker-compose.override.yml

# Dependencias del spike de la sala virtual (se instalan con npm install en esa carpeta).
scripts/spike-sala-livekit/node_modules/
scripts/spike-sala-livekit/package-lock.json
